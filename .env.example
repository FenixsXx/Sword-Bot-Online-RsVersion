# Copia questo file in .env e compila i valori. Non condividere mai il file .env.

# --- Obbligatorie ---
DISCORD_TOKEN=

# --- Consigliate ---
# ID del server: i comandi compaiono subito invece di attendere la sincronizzazione globale
GUILD_ID=
# Percorso del database SQLite (default: sword_bot.db)
DB_PATH=sword_bot.db

# --- Overlay live, API e sito staff (facoltative) ---
# Origine HTTPS pubblica dietro reverse proxy, es. https://sfo.example.com
EVENT_OVERLAY_PUBLIC_URL=
EVENT_OVERLAY_HOST=127.0.0.1
EVENT_OVERLAY_PORT=8765
PUBLIC_API_TOKEN=
SFO_SITE_DIR=sfo-site/dist

# --- Login Discord per il sito staff ---
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=

# --- Report staff (Supabase; la chiave service role resta solo sul server) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backup ---
# Directory persistente per i backup locali (default: ./backups)
BACKUP_DIR=
# Copia cifrata su storage S3-compatible (es. Cloudflare R2): servono tutte insieme
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PREFIX=sfo-backups
# Chiave Fernet: openssl rand -base64 32 | tr '+/' '-_'
BACKUP_ENCRYPTION_KEY=

# --- Audit ---
# Canale privato per il registro delle azioni staff (default: canale staff)
BOT_AUDIT_CHANNEL_ID=
